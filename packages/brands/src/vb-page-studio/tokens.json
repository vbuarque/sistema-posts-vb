{
  "meta": {
    "brand": "VB Page Studio",
    "instagram": "@vbpagestudio",
    "version": "1.0.0",
    "updated": "2026-11-06",
    "direction": "Grafite + Página",
    "units": "Todas as medidas em px na arte (1080 de largura). letterSpacing em em. lineHeight em px.",
    "paths": "Caminhos de arquivo relativos à pasta VB-Page-Studio-identidade-v2."
  },

  "color": {
    "bg": "#151515",
    "surface": "#222222",
    "surface2": "#2E2E2E",
    "line": "#3A3A3A",
    "decor": "#1E1E1E",
    "text": "#F3F3F3",
    "text2": "#B8B8B8",
    "text3": "#9A9A9A",
    "accent": "#3681F4",
    "ink": "#121212",
    "onAccent": "#121212",
    "paper": "#F3F3F3",
    "accentOnPaper": "#0C5FDE",
    "wire1": "#ABABAB",
    "wire2": "#C9C9C9",
    "wire3": "#D9D9D9"
  },

  "contrast": {
    "note": "Razões WCAG medidas. Texto < 66 px na arte precisa de 4.5; título >= 66 px pode usar 3.",
    "largeTextMinPx": 66,
    "pairs": [
      { "fg": "text", "bg": "bg", "ratio": 16.46 },
      { "fg": "text2", "bg": "bg", "ratio": 9.21 },
      { "fg": "text3", "bg": "bg", "ratio": 6.49 },
      { "fg": "accent", "bg": "bg", "ratio": 4.87 },
      { "fg": "onAccent", "bg": "accent", "ratio": 5.0 },
      { "fg": "text", "bg": "surface", "ratio": 14.34 },
      { "fg": "text2", "bg": "surface", "ratio": 8.02 },
      { "fg": "text3", "bg": "surface", "ratio": 5.65 },
      { "fg": "accent", "bg": "surface", "ratio": 4.25, "onlyLargeText": true },
      { "fg": "ink", "bg": "paper", "ratio": 16.88 },
      { "fg": "accentOnPaper", "bg": "paper", "ratio": 5.1 },
      { "fg": "accent", "bg": "paper", "ratio": 3.38, "onlyGraphics": true }
    ]
  },

  "font": {
    "family": "Montserrat",
    "stack": "\"Montserrat\", system-ui, sans-serif",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap",
    "license": "SIL Open Font License (uso comercial livre)",
    "weights": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },

  "textStyles": {
    "tituloCapa":   { "fontSize": 96,  "lineHeight": 104, "fontWeight": 300, "letterSpacing": -0.02, "color": "text" },
    "tituloStory":  { "fontSize": 100, "lineHeight": 108, "fontWeight": 300, "letterSpacing": -0.02, "color": "text" },
    "tituloPostNovo": { "fontSize": 72, "lineHeight": 80, "fontWeight": 300, "letterSpacing": -0.02, "color": "text" },
    "palavraChave": { "fontWeight": 700, "color": "accent", "note": "Aplicada dentro do título; herda tamanho e entrelinha. Uma por título." },
    "subtitulo":    { "fontSize": 54,  "lineHeight": 62,  "fontWeight": 300, "letterSpacing": 0, "color": "text2" },
    "texto":        { "fontSize": 36,  "lineHeight": 54,  "fontWeight": 400, "letterSpacing": 0, "color": "text2" },
    "rotulo":       { "fontSize": 26,  "lineHeight": 32,  "fontWeight": 600, "letterSpacing": 0.18, "color": "accent", "uppercase": true },
    "selo":         { "fontSize": 30,  "lineHeight": 36,  "fontWeight": 600, "letterSpacing": 0.12, "color": "onAccent" },
    "botao":        { "fontSize": 34,  "lineHeight": 40,  "fontWeight": 600, "letterSpacing": 0, "color": "onAccent" },
    "cabecalho":    { "fontSize": 30,  "lineHeight": 36,  "fontWeight": 600, "letterSpacing": 0, "color": "text" },
    "hashtag":      { "fontSize": 30,  "lineHeight": 36,  "fontWeight": 700, "letterSpacing": 0, "color": "text" },
    "meta":         { "fontSize": 30,  "lineHeight": 36,  "fontWeight": 500, "letterSpacing": 0, "color": "text3", "tabularNums": true },
    "lista":        { "fontSize": 36,  "lineHeight": 54,  "fontWeight": 400, "letterSpacing": 0, "color": "text" },
    "numero":       { "fontSize": 720, "lineHeight": 720, "fontWeight": 700, "letterSpacing": -0.05, "color": "decor" },
    "interrogacao": { "fontSize": 900, "lineHeight": 900, "fontWeight": 700, "letterSpacing": 0, "color": "decor" }
  },

  "spacing": { "xs": 8, "sm": 16, "md": 24, "lg": 40, "margin": 96 },

  "radius": { "pill": 999, "card": 16, "window": 22, "screen": 12 },

  "formats": {
    "carrossel": {
      "width": 1080, "height": 1350,
      "marginX": 96, "headerTop": 92, "contentTop": 290, "footerBottom": 96, "contentMaxWidth": 888,
      "maxLines": { "tituloCapa": 5, "tituloMeio": 3, "tituloFinal": 3, "texto": 3, "subtitulo": 2 }
    },
    "story": {
      "width": 1080, "height": 1920,
      "marginX": 96, "headerTop": 250, "contentTop": 470, "footerBottom": 340, "contentMaxWidth": 888,
      "stickerZone": { "x": 190, "y": 1080, "width": 700, "height": 360 },
      "maxLines": { "titulo": 3, "texto": 3 }
    },
    "destaque": { "width": 1080, "height": 1920, "discDiameter": 760, "iconSize": 460, "center": [540, 960] },
    "fotoPerfil": { "size": 320, "symbolRatio": 0.6 }
  },

  "components": {
    "cabecalho": {
      "logo": "02-logo/svg/logo-simbolo-escuro.svg", "logoWidth": 44, "logoHeight": 31, "gap": 16,
      "name": "VB Page Studio", "nameStyle": "cabecalho",
      "right": { "capa": "hashtag", "story": "hashtag", "meio": "contador", "final": "contador" }
    },
    "selo": { "height": 61, "paddingX": 30, "radius": "pill", "bg": "accent", "style": "selo", "gapBelow": 40,
      "textos": { "capa": "Swipe →", "enquete": "Responde aí", "postNovo": "Post novo" } },
    "rotulo": { "style": "rotulo", "gapBelow": 24, "maxWords": 3 },
    "contador": { "style": "meta", "format": "{n} / {total}", "padDigits": 2 },
    "rodape": { "text": "@vbpagestudio", "style": "meta", "layer": "front" },
    "botaoCta": { "height": 107, "paddingX": 56, "radius": "pill", "bg": "accent", "style": "botao", "arrow": "→",
      "gapAbove": 56, "supportGap": 28, "supportStyle": "meta", "supportDefault": "Orçamento sem compromisso · link na bio" },
    "numeroDecorativo": { "style": "numero", "value": "slideIndex", "padDigits": 2, "bleedBottom": 150, "offsetX": -40,
      "side": { "capa": "left", "default": "right" }, "layer": "back" },
    "janelaSite": { "capa": { "x": 540, "y": 930 }, "storyChamada": { "x": 540, "y": 1300 },
      "width": 620, "height": 360, "radius": "window", "bg": "surface",
      "bar": { "height": 52, "dotSize": 14, "dotGap": 10, "dotColor": "line", "addressWidth": 300, "addressHeight": 22, "addressColor": "surface2" },
      "screen": { "inset": 12, "radius": "screen", "bg": "paper", "screenshotSize": [1240, 720] } },
    "listaCheck": { "iconSize": 52, "iconBg": "accent", "checkColor": "onAccent", "checkStroke": 4, "gap": 28,
      "itemPaddingY": 24, "divider": { "width": 2, "color": "line" }, "style": "lista", "maxItems": 4 },
    "postNovoMiniatura": { "x": 243, "y": 850, "width": 594, "height": 743, "scale": 0.55, "rotate": -4,
      "border": { "width": 4, "color": "accent" }, "radius": "card", "titleMaxBottom": 830,
      "linkZone": { "x": 290, "y": 1640, "width": 500, "height": 120 }, "hasFooter": false }
  },

  "logo": {
    "clearSpace": "0.25 * altura do símbolo",
    "minSize": { "simboloAlturaPx": 24, "principalLarguraPx": 140, "horizontalAlturaPx": 32 },
    "svg": {
      "principalClaro": "02-logo/svg/logo-principal-claro.svg",
      "principalEscuro": "02-logo/svg/logo-principal-escuro.svg",
      "horizontalClaro": "02-logo/svg/logo-horizontal-claro.svg",
      "horizontalEscuro": "02-logo/svg/logo-horizontal-escuro.svg",
      "simboloClaro": "02-logo/svg/logo-simbolo-claro.svg",
      "simboloEscuro": "02-logo/svg/logo-simbolo-escuro.svg",
      "monoPreto": { "principal": "02-logo/svg/logo-principal-mono-preto.svg", "horizontal": "02-logo/svg/logo-horizontal-mono-preto.svg", "simbolo": "02-logo/svg/logo-simbolo-mono-preto.svg" },
      "monoBranco": { "principal": "02-logo/svg/logo-principal-mono-branco.svg", "horizontal": "02-logo/svg/logo-horizontal-mono-branco.svg", "simbolo": "02-logo/svg/logo-simbolo-mono-branco.svg" },
      "fotoPerfil": "02-logo/svg/foto-perfil-instagram.svg"
    },
    "png": {
      "fotoPerfil320": "02-logo/png/foto-perfil-instagram-320.png",
      "fotoPerfil1080": "02-logo/png/foto-perfil-instagram-1080.png"
    }
  },

  "destaques": {
    "portfolio":    { "png": "03-destaques/png/destaque-portfolio.png",     "icone": "04-icones/icone-portfolio.svg" },
    "comoFunciona": { "png": "03-destaques/png/destaque-como-funciona.png", "icone": "04-icones/icone-como-funciona.svg" },
    "valores":      { "png": "03-destaques/png/destaque-valores.png",       "icone": "04-icones/icone-valores.svg" },
    "depoimentos":  { "png": "03-destaques/png/destaque-depoimentos.png",   "icone": "04-icones/icone-depoimentos.svg" }
  },

  "copy": {
    "swipe": "Swipe →",
    "handle": "@vbpagestudio",
    "maxHashtagsCabecalho": 1,
    "maxHashtagsLegenda": 5,
    "noThirdPartyLogos": true
  }
}
